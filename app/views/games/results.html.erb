<div class="max-w-4xl mx-auto">
  <div class="bg-white rounded-lg shadow-lg p-6">
    <h1 class="text-3xl font-bold mb-6">Game Results</h1>
    
    <div class="mb-8">
      <h2 class="text-xl font-semibold mb-2"><%= @playlist.title %></h2>
      <p class="text-gray-600 mb-4"><%= @playlist.description %></p>
    </div>

    <div class="bg-blue-50 p-6 rounded-lg mb-8">
      <h3 class="text-xl font-semibold mb-4">Your Score</h3>
      <div class="text-4xl font-bold text-blue-600">
        <%= @score.points %> points
      </div>
      <p class="text-gray-600 mt-2">
        You liked <%= pluralize(@score.points, 'video') %> out of <%= @playlist.videos.count %>
      </p>
    </div>

    <div class="flex justify-between">
      <%= link_to "Play Again", play_playlist_games_path(@playlist), 
          class: "bg-blue-600 text-white px-6 py-3 rounded hover:bg-blue-700" %>
      <%= link_to "View All Scores", scores_path, 
          class: "bg-gray-600 text-white px-6 py-3 rounded hover:bg-gray-700" %>
    </div>
  </div>
</div>


