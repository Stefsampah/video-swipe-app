<div class="min-h-screen bg-gray-100 py-4 sm:py-8">
  <div class="max-w-md mx-auto px-2 sm:px-6 lg:px-8">
    <div class="bg-white shadow-lg overflow-hidden sm:rounded-lg">
      <div class="bg-indigo-600 px-4 py-4 sm:px-6">
        <h2 class="text-lg sm:text-xl font-bold text-white">Nouvelle Partie</h2>
      </div>

      <div class="p-4 sm:p-6">
        <div class="text-center">
          <p class="text-base sm:text-lg text-gray-600 mb-8">
            Prêt à jouer avec la playlist <span class="font-semibold text-gray-900"><%= @playlist.title %></span> ?
          </p>

          <%= form_with(model: [@playlist, @game], local: true) do |f| %>
            <div class="flex justify-center">
              <%= f.submit "Commencer", 
                  class: "inline-flex items-center px-6 py-3 text-base sm:text-lg font-medium rounded-lg text-white bg-indigo-600 hover:bg-indigo-700 transform hover:scale-105 transition-all focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div> 