<div class="min-h-screen bg-gray-100 py-6">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <% if @game.current_video %>
      <div class="bg-white shadow rounded-lg overflow-hidden">
        <div class="aspect-w-16 aspect-h-9">
          <iframe 
            class="w-full h-full"
            src="https://www.youtube.com/embed/<%= @game.current_video.youtube_id %>"
            title="YouTube video player"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen>
          </iframe>
        </div>

        <div class="p-6">
          <h2 class="text-2xl font-bold text-gray-900 mb-4"><%= @game.current_video.title %></h2>
          <% if @game.current_video.respond_to?(:description) && @game.current_video.description.present? %>
            <p class="text-gray-600 mb-6"><%= @game.current_video.description %></p>
          <% end %>

          <div class="flex justify-center space-x-4">
            <%= button_to "👎", swipe_playlist_game_path(@playlist, @game, direction: "dislike"), 
                method: :post, 
                class: "px-6 py-3 bg-red-500 text-white rounded-full hover:bg-red-600 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2" %>
            
            <%= button_to "👍", swipe_playlist_game_path(@playlist, @game, direction: "like"), 
                method: :post, 
                class: "px-6 py-3 bg-green-500 text-white rounded-full hover:bg-green-600 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2" %>
          </div>
        </div>
      </div>
    <% else %>
      <div class="text-center">
        <h2 class="text-2xl font-bold text-gray-900 mb-4">Félicitations !</h2>
        <p class="text-gray-600 mb-6">Vous avez terminé toutes les vidéos de cette playlist.</p>
        <%= link_to "Retour aux playlists", playlists_path, 
            class: "px-4 py-2 bg-indigo-600 text-white rounded-md hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" %>
      </div>
    <% end %>
  </div>
</div> 