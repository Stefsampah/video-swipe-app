<div class="min-h-screen bg-gray-100 py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-3xl mx-auto">
    <div class="bg-white rounded-xl shadow-lg overflow-hidden">
      <% if @current_video %>
        <!-- Game Header -->
        <div class="bg-blue-600 px-6 py-4">
          <div class="flex justify-between items-center">
            <h2 class="text-xl font-bold text-white"><%= @playlist.title %></h2>
            <div class="text-white">
              <span class="text-lg font-semibold">Score: <%= @score %></span>
            </div>
          </div>
        </div>

        <!-- Video Player -->
        <div class="p-6">
          <div class="aspect-w-16 aspect-h-9 mb-6">
            <iframe 
              class="w-full h-full rounded-lg"
              src="https://www.youtube.com/embed/<%= @current_video.youtube_id %>?autoplay=0&origin=<%= request.base_url %>&enablejsapi=1"
              title="<%= @current_video.title %>"
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen>
            </iframe>
          </div>

          <!-- Swipe Buttons -->
          <div class="flex justify-center space-x-8">
            <div class="flex space-x-8">
              <%= button_to swipe_playlist_game_path(@playlist, @game), 
                          method: :post, 
                          params: { direction: 'dislike', user_id: current_user.id }, 
                          class: "flex items-center justify-center w-16 h-16 rounded-full bg-red-500 text-white hover:bg-red-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500" do %>
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
              <% end %>

              <%= button_to swipe_playlist_game_path(@playlist, @game), 
                          method: :post, 
                          params: { direction: 'like', user_id: current_user.id }, 
                          class: "flex items-center justify-center w-16 h-16 rounded-full bg-green-500 text-white hover:bg-green-600 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-green-500" do %>
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
              <% end %>
            </div>
          </div>
        </div>
      <% else %>
        <!-- Results Page -->
        <div class="text-center py-8 px-4">
          <h1 class="text-2xl font-bold text-gray-800 mb-2"><%= @playlist.title %> - Résultats manche <%= @game.id %></h1>
          
          <div class="my-8">
            <div class="text-4xl font-bold text-purple-600 mb-6">
              What a Beam
            </div>
            <div class="text-5xl font-bold text-purple-600 mb-8">
              5th Place !
            </div>

            <!-- User Avatar -->
            <div class="flex justify-center mb-6">
              <div class="w-32 h-32 rounded-full bg-gray-300 overflow-hidden">
                <% if current_user.avatar.attached? %>
                  <%= image_tag current_user.avatar, class: "w-full h-full object-cover" %>
                <% else %>
                  <svg class="w-full h-full text-gray-500" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                  </svg>
                <% end %>
              </div>
            </div>

            <p class="text-lg text-gray-600 mb-2">Me</p>
            <div class="text-6xl font-bold text-purple-600 mb-8"><%= @score %></div>

            <!-- Songs Results -->
            <div class="max-w-md mx-auto bg-purple-600 rounded-lg overflow-hidden mb-8">
              <div class="p-4">
                <h3 class="text-white font-semibold mb-4">SONGS LIKED</h3>
                <div class="space-y-3">
                  <% @game.swipes.where(liked: true).each do |swipe| %>
                    <div class="flex justify-between text-white">
                      <span class="text-left"><%= swipe.video.title %></span>
                      <span class="text-right">+1</span>
                    </div>
                  <% end %>
                </div>
              </div>
            </div>

            <!-- Navigation Buttons -->
            <div class="space-y-4">
              <%= link_to "Voir le Classement", scores_path, 
                  class: "block w-full py-3 px-4 text-center font-medium text-white bg-purple-600 hover:bg-purple-700 rounded-lg transition duration-150" %>
              
              <%= link_to "Suivant", playlists_path, 
                  class: "block w-full py-3 px-4 text-center font-medium text-white bg-blue-600 hover:bg-blue-700 rounded-lg transition duration-150" %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div> 